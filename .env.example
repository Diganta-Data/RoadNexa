# RoadNexa environment template

# Backend database.
# Use a Postgres database with PostGIS enabled.
# Local async example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roadnexa
# Cloud examples from Render/Supabase usually use postgres:// or postgresql://;
# the backend converts them to asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME

# Backend service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-random-secret-key
UPLOAD_DIR=data/uploads

# Comma-separated frontend URLs allowed to call the API.
# After Vercel deploy, add your Vercel production URL here in Render.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-roadnexa-app.vercel.app

# Optional AI providers used by analysis services, if enabled in the UI/API.
GEMINI_API_KEY=
GROQ_API_KEY=

# Frontend
# On Vercel set this to your Render backend URL, for example:
# VITE_API_BASE_URL=https://roadnexa-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000
