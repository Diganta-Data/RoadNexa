# --- Data (keep structure, ignore large files) ---
data/raw/*
data/staging/*
data/processed/*
data/rejected/*
data/uploads/*
backend/data/uploads/*
backend/data/raw/*
backend/data/staging/*
backend/data/processed/*
backend/data/rejected/*
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/processed/.gitkeep
!data/rejected/.gitkeep
!data/uploads/.gitkeep
!backend/data/uploads/.gitkeep
!backend/data/raw/.gitkeep
!backend/data/staging/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/rejected/.gitkeep
